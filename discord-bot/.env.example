DISCORD_BOT_TOKEN=
# Recommended for development (register commands in one guild immediately):
DISCORD_GUILD_ID=

# Pool: newline manifest + dated `bcp-matches-YYYY-MM-DD.json` shards beside it.
# Typical local dev: run from repo root; on droplet omit ELO_MATCHES_* unless you use absolute paths
# (/opt/eloevent/repo/bcp-matches.manifest).
ELO_MATCHES_MANIFEST=bcp-matches.manifest
# Legacy monolith only — omit both when passing -matches-manifest on the CLI:
# ELO_MATCHES_JSON=bcp-matches.json
ELO_LEADERBOARD_JSON=leaderboard.json

# Optional: Discord channel snowflake OR channel name (e.g. elo-hell). With a name,
# DISCORD_GUILD_ID or -guild must be set so the bot can resolve the channel.
# ELO_LEADERBOARD_ANNOUNCE_CHANNEL=elo-hell
