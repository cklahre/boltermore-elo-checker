# Optional: /opt/eloevent/env/refresh.env — sourced by refresh-leaderboard.sh and pull-matches.sh
#
# Weekly systemd timer (Mon 20:00 UTC) sets PULL_MATCHES=1 so each run harvests new BCP
# events since the newest bcp-matches-YYYY-MM-DD.json shard, writes a new dated shard under
# /opt/eloevent/data/, regenerates the manifest, then rebuilds leaderboard.json.
#
# PULL_MATCHES=1
#
# Optional overrides for pull-matches.sh:
# SINCE=2026-07-21              # force -since instead of day-after newest shard
# EXPORT_SLEEP_MS=300           # pause between events during export
# HARVEST_MIN_INTERVAL_MS=350   # throttle BCP HTTP GETs
# GT filters (defaults below) — drops RTTs / leagues / long campaigns:
# MIN_PLAYERS=20
# MIN_ROUNDS=5
# MAX_SPAN_DAYS=7
# EXCLUDE_NAME=league,season,ladder,rtt,team,teams
#
# Extra hook AFTER pull (optional): still supported for custom fetch/copy steps
# UPDATE_MATCHES_CMD='…'
#
# Transition / emergency: curl a legacy monolith into data/ (skips dated-shard workflow)
# UPDATE_MATCHES_CMD='curl -fsSL -o /opt/eloevent/data/bcp-matches.json "https://…"'
#
PULL_MATCHES=1
