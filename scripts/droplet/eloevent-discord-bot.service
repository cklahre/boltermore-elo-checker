[Unit]
Description=Elo Discord bot (Boltermore / fortyk eloevent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eloevent
EnvironmentFile=-/opt/eloevent/env/bot.env
# Match inputs must mirror refresh-leaderboard.sh (recommended):
# ExecStart=/opt/eloevent/bin/eloevent-bot \
#   -matches-manifest /opt/eloevent/data/bcp-matches.manifest \
#   -leaderboard /opt/eloevent/data/leaderboard.json \
#   -reload 5m
# Or single-file + periodic reload:
ExecStart=/opt/eloevent/bin/eloevent-bot \
  -matches /opt/eloevent/data/bcp-matches.json \
  -leaderboard /opt/eloevent/data/leaderboard.json
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
