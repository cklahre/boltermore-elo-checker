[Unit]
Description=Elo Discord bot (Boltermore / fortyk eloevent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eloevent
EnvironmentFile=-/opt/eloevent/env/bot.env
# Match inputs must mirror refresh-leaderboard.sh (recommended).
# Optional: `-guild` must be in bot.env (DISCORD_GUILD_ID) if you announce by channel name:
#   `-announce-leaderboard-channel elo-hell` or set ELO_LEADERBOARD_ANNOUNCE_CHANNEL in bot.env.
# Stamp file `.leaderboard-announce-as_of` is written beside leaderboard.json on first run (no Discord post).
# ExecStart=/opt/eloevent/bin/eloevent-bot \
#   -matches-manifest /opt/eloevent/data/bcp-matches.manifest \
#   -leaderboard /opt/eloevent/data/leaderboard.json \
#   -reload 5m \
#   -announce-leaderboard-channel elo-hell
# Launcher picks data/bcp-matches.* first, then repo mirror (GitHub Actions rsync checkout).
ExecStart=/opt/eloevent/scripts/start-eloevent-discord-bot.sh
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
