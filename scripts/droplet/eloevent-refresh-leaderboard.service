[Unit]
Description=Pull new BCP matches, regenerate Elo leaderboard, restart Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PULL_MATCHES=1
EnvironmentFile=-/opt/eloevent/env/refresh.env
ExecStart=/bin/bash /opt/eloevent/scripts/refresh-leaderboard.sh

# Harvest + export of a busy week can run for hours; never overlap with the next Monday:
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
